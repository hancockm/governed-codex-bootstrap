# Optional external A2A critique providers.
#
# Copy this file to .env and configure only providers you have separately
# installed, authenticated, authorized, and tested. The repository ignores
# .env. Do not put API keys or other credentials in this file; authenticate
# through the provider CLI or an operating-system secret mechanism.
#
# Commands run without a shell from an isolated directory under tmp/. The
# handoff prompt is appended as one final argument when INPUT_MODE=argument,
# or sent on standard input when INPUT_MODE=stdin. Verify each command against
# the exact installed CLI version before use.

# Anthropic Claude Code print mode.
PROJECT_CLAUDE_COMMAND=claude -p --output-format text --permission-mode plan --no-session-persistence
PROJECT_CLAUDE_INPUT_MODE=argument
PROJECT_CLAUDE_MODEL_ID=

# Google Gemini CLI headless text mode. Availability and authentication vary
# by account and deployment.
PROJECT_GEMINI_COMMAND=gemini -p --output-format text
PROJECT_GEMINI_INPUT_MODE=argument
PROJECT_GEMINI_MODEL_ID=

# MiniMax official CLI text chat.
PROJECT_MMX_COMMAND=mmx text chat --message
PROJECT_MMX_INPUT_MODE=argument
PROJECT_MMX_MODEL_ID=

# Optional locally installed wrappers. Leave blank until their exact command
# contract is verified. A stdin command must read the complete prompt from
# standard input and return critique Markdown on standard output.
PROJECT_AGY_COMMAND=
PROJECT_AGY_INPUT_MODE=stdin
PROJECT_AGY_MODEL_ID=
PROJECT_CODEX_COMMAND=
PROJECT_CODEX_INPUT_MODE=stdin
PROJECT_CODEX_MODEL_ID=
