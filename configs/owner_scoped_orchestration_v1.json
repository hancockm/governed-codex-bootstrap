{
  "schema_version": "owner_scoped_orchestration_v1",
  "authority": "development_orchestration",
  "topology": "hybrid",
  "model_binding": {
    "enforcement": "fail_closed",
    "owner_orchestrator": {"model": "gpt-5.6-sol", "reasoning_effort": "xhigh"},
    "implementer": {"model": "gpt-5.6-terra", "reasoning_effort": "high"},
    "runner": {"model": "gpt-5.6-luna", "reasoning_effort": "max"}
  },
  "git": {
    "canonical_remote": "origin",
    "canonical_branch": "master",
    "master_integration_owner": "core"
  },
  "subordinate_task_lifecycle": {
    "saved_project_required": true,
    "reuse_runner_thread_per_cycle": true,
    "archive_owner": "owner_orchestrator",
    "archive_after": [
      "accepted_exact_candidate_receipt",
      "no_correction_pending",
      "commit_push_integration",
      "primary_branch_sync",
      "terminal_reconciliation",
      "worktree_cleanup"
    ],
    "finalization_requires": [
      "recorded_receipt_hashes",
      "subordinate_task_dispositions",
      "terminal_reconciliation",
      "primary_branch_sync",
      "worktree_removal",
      "archive_acknowledgment"
    ],
    "visible_nonterminal_statuses": ["failed", "blocked", "user_input_needed"]
  },
  "owners": {
    "core": {
      "status": "active",
      "git_owner": "core",
      "branch_prefix": "core/",
      "profile_path": "roles/core/orchestration_profile.json",
      "continuity_receipts_root": "Project_Obsidian_Vault/30_Core/Continuity/Orchestration Receipts"
    },
    "example_feature": {
      "status": "owner_adoption_required",
      "git_owner": "feature_example",
      "branch_prefix": "feature-example/",
      "profile_path": "future_owners/example-feature-owner/orchestration_profile.json"
    },
    "owner_template": {
      "status": "owner_adoption_required",
      "git_owner": "replace_owner",
      "branch_prefix": "replace-owner/",
      "profile_path": "future_owners/owner-template/orchestration_profile.json"
    }
  },
  "aliases": {"application": "core", "operations": "core", "runtime": "core"},
  "support_roles": ["review", "handoff"]
}
