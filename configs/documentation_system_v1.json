  "adaptation_dispositions": {
    "shared_repository_governance": "retain as project-neutral operational contracts",
    "core_owner_workflow": "retain authority and evidence behavior while deriving project doctrine from research",
    "owner_specific_instruction_sets": "create only during explicit owner activation from the inactive owner template",
    "owner_specific_continuity_packs": "create only for an activated owner and never prepopulate with reference transcripts",
    "product_runtime_architecture": "exclude because runtime doctrine must be derived from this project's research",
    "domain_parameter_manuals": "exclude until a recognized owner and accepted domain contract require them",
    "product_specific_tooling": "classify separately in the tool parity manifest"
  },
  "vault_reference_dispositions": {
    "plane_readmes": "retain as project-neutral practical entry points linked from maintained MOCs",
    "shared_instruction_hub": "retain reusable coordination, planning, publication, and context-compression behavior",
    "core_owner_instructions": "adapt to empty-domain Core authority and research-first startup",
    "future_owner_instructions": "generate only after Core recognition and preserve inactive templates as non-authorizing",
    "owner_continuity_packs": "create for activated owners with one thread owner and no copied reference history",
    "transcript_and_month_readmes": "generate only when transcript exports exist; do not seed empty synthetic archives",
    "feature_readmes": "create when a feature boundary is recognized and document its actual owner and public dependencies",
    "publication_and_summary_readmes": "defer until a publication owner or accepted reader-facing capability exists",
    "product_and_domain_manuals": "exclude until local research and canonical decisions establish the corresponding project need",
    "historical_rollout_records": "exclude from the clean bootstrap while retaining the reusable maintenance and activation protocols"
  }
